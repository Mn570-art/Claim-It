# Copy to backend/.env. Leave the key empty to use Demo mode.
# Create a key at https://indus.sarvam.ai and put it only in this file.
SARVAM_API_KEY=

MAX_UPLOAD_MB=10
MAX_PDF_PAGES=20
DATABASE_URL=sqlite:///./data/claimit.db
UPLOAD_DIR=./data/uploads
SAMPLE_DIR=../sample_data
CORS_ORIGINS=http://127.0.0.1:43123,http://localhost:43123
SARVAM_TIMEOUT_SECONDS=60
DOC_JOB_TIMEOUT_SECONDS=180
RETENTION_DAYS=30
